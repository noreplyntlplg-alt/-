/* ==========================================================================
   ARAMS - CSS Stylesheet
   Theme: Minimal & Formal (Navy Blue & Emerald Green)
   Font: TH Sarabun PSK (Sarabun)
========================================================================== */

/* --- CSS Variables (Color Palette & Settings) --- */
:root {
    /* Primary Colors */
    --primary-color: #1a365d; /* น้ำเงินกรมท่า (Navy Blue) */
    --primary-hover: #2a4365;
    --secondary-color: #2f855a; /* เขียวมรกต (Emerald Green) */
    --secondary-hover: #276749;
    
    /* Background & Surface Colors */
    --bg-main: #f4f7f6;
    --bg-surface: #ffffff;
    --sidebar-bg: #112240; /* กรมท่าเข้มสำหรับ Sidebar */
    --sidebar-hover: #1e3a5f;
    
    /* Text Colors */
    --text-main: #2d3748;
    --text-muted: #718096;
    --text-light: #f8fafc;
    
    /* Status Colors */
    --danger: #e53e3e;
    --warning: #d69e2e;
    --info: #3182ce;
    --success: #38a169;

    /* Borders & Shadows */
    --border-color: #e2e8f0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
    
    /* Typography */
    --font-family: 'Sarabun', sans-serif;
    --transition: all 0.3s ease;
}

/* --- Reset & Global Styles --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-family);
    font-size: 16px;
    color: var(--text-main);
    background-color: var(--bg-main);
    line-height: 1.5;
    overflow-x: hidden;
}

/* ทำให้ฟอนต์ Sarabun อ่านง่ายและดูทางการขึ้น */
h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    color: var(--primary-color);
}

a { text-decoration: none; color: inherit; }
ul { list-style: none; }
button { font-family: var(--font-family); cursor: pointer; border: none; outline: none; }
input, select, textarea { font-family: var(--font-family); }

/* --- Utility Classes --- */
.hidden { display: none !important; }
.text-primary { color: var(--primary-color); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }
.text-muted { color: var(--text-muted); }

/* ================= LOGIN SECTION ================= */
.login-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background: linear-gradient(135deg, #1a365d 0%, #2f855a 100%);
}

.login-box {
    background-color: var(--bg-surface);
    padding: 40px;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 420px;
    text-align: center;
}

.login-header { margin-bottom: 30px; }
.login-header .logo-icon {
    font-size: 50px;
    color: var(--primary-color);
    margin-bottom: 10px;
}
.login-header h2 { font-size: 32px; letter-spacing: 1px; }
.login-header p { color: var(--text-muted); font-size: 18px; }

.login-form .input-group {
    text-align: left;
    margin-bottom: 20px;
}
.login-form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--text-main);
}
.login-form input {
    width: 100%;
    padding: 12px 15px;
    font-size: 16px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    transition: var(--transition);
}
.login-form input:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(26, 54, 93, 0.2);
}

.btn-primary {
    width: 100%;
    padding: 12px;
    background-color: var(--primary-color);
    color: white;
    font-size: 18px;
    font-weight: 600;
    border-radius: 6px;
    transition: var(--transition);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
}
.btn-primary:hover { background-color: var(--primary-hover); }

.login-footer { margin-top: 25px; font-size: 14px; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 15px; }

/* ================= MAIN APPLICATION LAYOUT ================= */
.app-wrapper { display: flex; height: 100vh; overflow: hidden; }

/* --- Sidebar --- */
.sidebar {
    width: 260px;
    background-color: var(--sidebar-bg);
    color: var(--text-light);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    z-index: 1000;
}

.sidebar-brand {
    height: 70px;
    display: flex;
    align-items: center;
    padding: 0 20px;
    font-size: 24px;
    font-weight: 700;
    background-color: rgba(0, 0, 0, 0.2);
    gap: 15px;
}

.sidebar-user-info {
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.user-avatar i { font-size: 40px; color: var(--secondary-color); }
.user-details { display: flex; flex-direction: column; }
.user-name { font-size: 18px; font-weight: 600; }
.user-role { font-size: 14px; color: #a0aec0; }

.sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 15px 0;
}
/* Scrollbar สวยๆ สำหรับ Sidebar */
.sidebar-nav::-webkit-scrollbar { width: 6px; }
.sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }

.menu-header {
    padding: 10px 20px 5px 20px;
    font-size: 14px;
    color: #718096;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    margin-top: 10px;
}
.nav-item {
    padding: 12px 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 15px;
    font-size: 17px;
    transition: var(--transition);
    border-left: 4px solid transparent;
}
.nav-item i { width: 20px; text-align: center; }
.nav-item:hover { background-color: var(--sidebar-hover); }
.nav-item.active {
    background-color: var(--sidebar-hover);
    border-left-color: var(--secondary-color);
    color: white;
    font-weight: 500;
}

/* --- Main Content --- */
.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: calc(100% - 260px);
}

/* --- Topbar --- */
.topbar {
    height: 70px;
    background-color: var(--bg-surface);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 25px;
    box-shadow: var(--shadow-sm);
    z-index: 10;
}
.topbar-left, .topbar-right { display: flex; align-items: center; gap: 15px; }

.page-title { font-size: 22px; margin: 0; color: var(--primary-color); }

.btn-icon {
    background: transparent;
    border: none;
    font-size: 20px;
    color: var(--text-muted);
    cursor: pointer;
    position: relative;
    padding: 5px;
    transition: var(--transition);
}
.btn-icon:hover { color: var(--primary-color); }

.badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background-color: var(--danger);
    color: white;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 50%;
}

.divider { height: 30px; width: 1px; background-color: var(--border-color); margin: 0 10px; }

.btn-outline-danger {
    background: transparent;
    border: 1px solid var(--danger);
    color: var(--danger);
    padding: 8px 15px;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition);
}
.btn-outline-danger:hover { background: var(--danger); color: white; }

/* --- Content Area --- */
.content-container {
    flex: 1;
    padding: 25px;
    overflow-y: auto;
    background-color: var(--bg-main);
}

/* --- App Footer --- */
.app-footer {
    text-align: center;
    padding: 15px;
    font-size: 14px;
    color: var(--text-muted);
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-color);
}

/* ================= DASHBOARD & COMPONENTS (เตรียมไว้สำหรับ JS Inject) ================= */
.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
}

.stat-card {
    background-color: var(--bg-surface);
    padding: 20px;
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 20px;
    border-left: 5px solid var(--primary-color);
    transition: var(--transition);
}
.stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.stat-card.green { border-left-color: var(--secondary-color); }
.stat-card.red { border-left-color: var(--danger); }
.stat-card.yellow { border-left-color: var(--warning); }

.stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 24px;
    color: white;
    background-color: var(--primary-color);
}
.stat-icon.green { background-color: var(--secondary-color); }
.stat-icon.red { background-color: var(--danger); }
.stat-icon.yellow { background-color: var(--warning); }

.stat-details h4 { font-size: 16px; color: var(--text-muted); font-weight: 500; margin-bottom: 5px; }
.stat-details p { font-size: 28px; font-weight: 700; color: var(--text-main); margin: 0; line-height: 1; }

/* Panel & Tables */
.panel {
    background-color: var(--bg-surface);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    padding: 20px;
    margin-bottom: 25px;
}
.panel-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; margin-bottom: 15px; }
.panel-title { font-size: 20px; }

.table-responsive { overflow-x: auto; }
.table-arams { width: 100%; border-collapse: collapse; font-size: 16px; }
.table-arams th, .table-arams td { padding: 12px 15px; text-align: left; border-bottom: 1px solid var(--border-color); }
.table-arams th { background-color: #f8fafc; color: var(--primary-color); font-weight: 600; white-space: nowrap; }
.table-arams tbody tr:hover { background-color: #f1f5f9; }
.table-arams .status-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
}
.status-badge.success { background-color: #c6f6d5; color: #22543d; }
.status-badge.danger { background-color: #fed7d7; color: #742a2a; }
.status-badge.warning { background-color: #fefcbf; color: #744210; }

/* Action Buttons in Table */
.btn-sm { padding: 5px 10px; font-size: 14px; border-radius: 4px; margin-right: 5px; color: white; }
.btn-edit { background-color: var(--warning); }
.btn-delete { background-color: var(--danger); }
.btn-view { background-color: var(--info); }

/* Form Controls in Panels */
.form-row { display: flex; gap: 15px; margin-bottom: 15px; flex-wrap: wrap; }
.form-group { flex: 1; min-width: 200px; display: flex; flex-direction: column; }
.form-group label { margin-bottom: 5px; font-weight: 500; }
.form-control { padding: 10px; border: 1px solid var(--border-color); border-radius: 5px; font-size: 16px; transition: 0.3s; }
.form-control:focus { border-color: var(--primary-color); outline: none; box-shadow: 0 0 0 2px rgba(26,54,93,0.1); }
.btn-submit { background-color: var(--secondary-color); color: white; padding: 10px 20px; font-size: 16px; border-radius: 5px; font-weight: bold; }
.btn-submit:hover { background-color: var(--secondary-hover); }

/* ================= LOADERS ================= */
.loading-screen { display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100%; gap: 15px; color: var(--primary-color); }
.loading-screen p { font-size: 20px; font-weight: 500; }

.global-loader {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
}
.spinner-box {
    display: flex; flex-direction: column; align-items: center; gap: 15px;
    font-size: 24px; color: var(--primary-color); font-weight: bold;
}
.spinner-box i { font-size: 50px; color: var(--secondary-color); }

/* ================= RESPONSIVE DESIGN ================= */
.mobile-only { display: none; background: transparent; border: none; color: white; font-size: 24px; cursor: pointer; }

@media (max-width: 992px) {
    .dashboard-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
    /* ซ่อน Sidebar ในมือถือ */
    .sidebar {
        position: fixed;
        left: -260px;
        height: 100%;
        box-shadow: var(--shadow-lg);
    }
    .sidebar.show { left: 0; }
    
    .main-content { width: 100%; }
    
    .mobile-only { display: block; }
    #btn-toggle-sidebar { display: block; }

    /* Overlay พื้นหลังดำตอนเปิดเมนู */
    .overlay {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 999;
    }
    
    .dashboard-grid { grid-template-columns: 1fr; }
    
    .topbar { padding: 0 15px; }
    .page-title { font-size: 18px; }
    
    .form-row { flex-direction: column; gap: 10px; }
}
